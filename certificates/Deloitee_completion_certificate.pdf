[32m+[m[32m/* ====================== Utilities ====================== */[m
[32m+[m[32mconst $ = (sel, ctx = document) => ctx.querySelector(sel);[m
[32m+[m[32mconst $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));[m
[32m+[m
[32m+[m[32mfunction linkFor(path){[m
[32m+[m[32m  return encodeURI(path);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ====================== Typing effect ====================== */[m
[32m+[m[32mfunction runTypingEffect(containerId, lines, opts = {}) {[m
[32m+[m[32m  const el = document.getElementById(containerId);[m
[32m+[m[32m  if(!el) return;[m
[32m+[m[32m  const typingSpeed = opts.typingSpeed || 36;[m
[32m+[m[32m  const pauseBetween = opts.pauseBetween || 900;[m
[32m+[m[32m  let lineIndex = 0;[m
[32m+[m
[32m+[m[32m  function typeLine(line, i = 0){[m
[32m+[m[32m    if(i <= line.length){[m
[32m+[m[32m      el.textContent = line.slice(0, i);[m
[32m+[m[32m      setTimeout(()=> typeLine(line, i+1), typingSpeed);[m
[32m+[m[32m    } else {[m
[32m+[m[32m      setTimeout(()=> {[m
[32m+[m[32m        lineIndex++;[m
[32m+[m[32m        if(lineIndex < lines.length){[m
[32m+[m[32m          typeLine(lines[lineIndex]);[m
[32m+[m[32m        }[m
[32m+[m[32m      }, pauseBetween);[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m  typeLine(lines[0]);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ====================== Smooth scrolling & nav behavior ====================== */[m
[32m+[m[32mfunction initNav(){[m
[32m+[m[32m  document.addEventListener('click', e => {[m
[32m+[m[32m    const a = e.target.closest('a[href^="#"]');[m
[32m+[m[32m    if(!a) return;[m
[32m+[m[32m    const href = a.getAttribute('href');[m
[32m+[m[32m    if(href === '#') return;[m
[32m+[m[32m    e.preventDefault();[m
[32m+[m[32m    const dest = document.querySelector(href);[m
[32m+[m[32m    if(dest){[m
[32m+[m[32m      dest.scrollIntoView({behavior:'smooth', block:'start'});[m
[32m+[m[32m      const toggle = $('.nav-toggle');[m
[32m+[m[32m      if(toggle && toggle.getAttribute('aria-expanded') === 'true') toggle.click();[m
[32m+[m[32m    }[m
[32m+[m[32m  });[m
[32m+[m
[32m+[m[32m  const toggle = $('.nav-toggle');[m
[32m+[m[32m  const menu = $('#nav-menu');[m
[32m+[m[32m  if(toggle && menu){[m
[32m+[m[32m    toggle.addEventListener('click', () => {[m
[32m+[m[32m      const open = toggle.getAttribute('aria-expanded') === 'true';[m
[32m+[m[32m      toggle.setAttribute('aria-expanded', (!open).toString());[m
[32m+[m[32m      menu.style.display = open ? 'none' : 'flex';[m
[32m+[m[32m    });[m
[32m+[m[32m  }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction initThemeSwitcher(){[m
[32m+[m[32m  const buttons = $$('.theme-pill');[m
[32m+[m[32m  if(!buttons.length) return;[m
[32m+[m
[32m+[m[32m  const storageKey = 'portfolio-theme';[m
[32m+[m[32m  const defaultTheme = 'theme-royal';[m
[32m+[m
[32m+[m[32m  function applyTheme(themeClass){[m
[32m+[m[32m    document.body.classList.remove('theme-royal', 'theme-emerald');[m
[32m+[m[32m    if(themeClass) document.body.classList.add(themeClass);[m
[32m+[m[32m    buttons.forEach(button => {[m
[32m+[m[32m      const isActive = button.dataset.theme === themeClass;[m
[32m+[m[32m      button.classList.toggle('is-active', isActive);[m
[32m+[m[32m      button.setAttribute('aria-pressed', String(isActive));[m
[32m+[m[32m    });[m
[32m+[m[32m    if(!themeClass){[m
[32m+[m[32m      const warmButton = buttons.find(button => button.dataset.theme === '');[m
[32m+[m[32m      if(warmButton) warmButton.classList.add('is-active');[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  const savedTheme = localStorage.getItem(storageKey) || defaultTheme;[m
[32m+[m[32m  localStorage.setItem(storageKey, savedTheme);[m
[32m+[m[32m  applyTheme(savedTheme);[m
[32m+[m
[32m+[m[32m  buttons.forEach(button => {[m
[32m+[m[32m    button.addEventListener('click', () => {[m
[32m+[m[32m      const nextTheme = button.dataset.theme || '';[m
[32m+[m[32m      localStorage.setItem(storageKey, nextTheme);[m
[32m+[m[32m      applyTheme(nextTheme);[m
[32m+[m[32m    });[m
[32m+[m[32m  });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ====================== Scroll reveal & skill animation ====================== */[m
[32m+[m[32mfunction initRevealAndSkills(){[m
[32m+[m[32m  const observer = new IntersectionObserver((entries) => {[m
[32m+[m[32m    entries.forEach(entry => {[m
[32m+[m[32m      if(entry.isIntersecting){[m
[32m+[m[32m        entry.target.classList.add('is-revealed');[m
[32m+[m[32m        if(entry.target.id === 'skills' || entry.target.closest('#skills')){[m
[32m+[m[32m          $$('.skill-bar').forEach(bar => {[m
[32m+[m[32m            const level = Number(bar.dataset.level || 0);[m
[32m+[m[32m            const fill = bar.querySelector('.skill-fill');[m
[32m+[m[32m            if(fill){ requestAnimationFrame(()=> fill.style.width = level + '%'); }[m
[32m+[m[32m          });[m
[32m+[m[32m        }[m
[32m+[m[32m      }[m
[32m+[m[32m    });[m
[32m+[m[32m  }, {threshold: 0.12});[m
[32m+[m
[32m+[m[32m  $$('.reveal').forEach(el => observer.observe(el));[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ====================== Certificates grid ====================== */[m
[32m+[m[32mfunction renderCertificates(){[m
[32m+[m[32m  const grid = $('#cert-grid');[m
[32m+[m[32m  if(!grid) return;[m
[32m+[m[32m  CERTIFICATES.forEach(cert => {[m
[32m+[m[32m    const link = linkFor(cert.file);[m
[32m+[m[32m    const card = document.createElement('a');[m
[32m+[m[32m    card.className = 'cert-card';[m
[32m+[m[32m    card.href = link;[m
[32m+[m[32m    card.target = '_blank';[m
[32m+[m[32m    card.rel = 'noopener';[m
[32m+[m[32m    card.title = cert.name;[m
[32m+[m
[32m+[m[32m    card.innerHTML = `[m
[32m+[m[32m      <div class="cert-thumb" aria-hidden="true">[m
[32m+[m[32m        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">[m
[32m+[m[32m          <path d="M7 2h8l4 4v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h3z" stroke="#0f1724" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/>[m
[32m+[m[32m        </svg>[m
[32m+[m[32m      </div>[m
[32m+[m[32m      <div class="cert-info">[m
