[32m+[m[32m      </div>[m
[32m+[m[32m    `;[m
[32m+[m[32m    grid.appendChild(card);[m
[32m+[m[32m  });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ====================== Projects wiring ====================== */[m
[32m+[m[32mfunction wireProjects(){[m
[32m+[m[32m  const grid = document.getElementById('project-grid');[m
[32m+[m[32m  if(!grid) return;[m
[32m+[m
[32m+[m[32m  grid.innerHTML = '';[m
[32m+[m
[32m+[m[32m  PROJECTS.forEach((project, index) => {[m
[32m+[m[32m    const card = document.createElement('article');[m
[32m+[m[32m    card.className = 'project-card reveal';[m
[32m+[m[32m    card.dataset.project = String(index);[m
[32m+[m
[32m+[m[32m    card.innerHTML = `[m
[32m+[m[32m      <div class="project-media project-media--github">[m
[32m+[m[32m        <div class="project-badge">GitHub</div>[m
[32m+[m[32m        <svg viewBox="0 0 400 260" class="project-thumb" preserveAspectRatio="xMidYMid slice" aria-hidden="true">[m
[32m+[m[32m          <rect width="400" height="260" rx="12" fill="#0f1724" opacity="0.05"></rect>[m
[32m+[m[32m          <g transform="translate(24,30)">[m
[32m+[m[32m            <rect width="220" height="30" rx="8" fill="#0f1724"></rect>[m
[32m+[m[32m            <rect y="48" width="300" height="12" rx="6" fill="#eef6f5"></rect>[m
[32m+[m[32m            <rect y="72" width="250" height="12" rx="6" fill="#f7fbfb"></rect>[m
[32m+[m[32m            <rect y="96" width="180" height="12" rx="6" fill="#eef6f5"></rect>[m
[32m+[m[32m          </g>[m
[32m+[m[32m        </svg>[m
[32m+[m[32m      </div>[m
[32m+[m[32m      <div class="project-body">[m
[32m+[m[32m        <h3 class="project-title">${project.title}</h3>[m
[32m+[m[32m        <p class="project-excerpt">${project.desc}</p>[m
[32m+[m[32m        <div class="tech-badges">[m
[32m+[m[32m          <span class="tech-badge">${project.tech}</span>[m
[32m+[m[32m        </div>[m
[32m+[m[32m        <div class="project-meta">[m
[32m+[m[32m          <a href="${project.href}" class="link" target="_blank" rel="noopener">Open repo</a>[m
[32m+[m[32m        </div>[m
[32m+[m[32m      </div>[m
[32m+[m[32m    `;[m
[32m+[m
[32m+[m[32m    grid.appendChild(card);[m
[32m+[m[32m    requestAnimationFrame(() => card.classList.add('is-revealed'));[m
[32m+[m[32m  });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction setYear(){ document.getElementById('year').textContent = new Date().getFullYear(); }[m
[32m+[m
[32m+[m[32mfunction initEnquiryForm(){[m
[32m+[m[32m  const form = document.getElementById('enquiry-form');[m
[32m+[m[32m  if(!form) return;[m
[32m+[m
[32m+[m[32m  form.addEventListener('submit', (event) => {[m
[32m+[m[32m    event.preventDefault();[m
[32m+[m[32m    const formData = new FormData(form);[m
[32m+[m[32m    const name = String(formData.get('name') || '').trim();[m
[32m+[m[32m    const subject = String(formData.get('subject') || 'Portfolio enquiry').trim();[m
[32m+[m[32m    const message = String(formData.get('message') || '').trim();[m
[32m+[m[32m    const mailTo = 'kanhaiyadalvi548@gmail.com';[m
[32m+[m[32m    const body = [[m
[32m+[m[32m      `Name: ${name}`,[m
[32m+[m[32m      '',[m
[32m+[m[32m      message[m
[32m+[m[32m    ].join('\n');[m
[32m+[m
[32m+[m[32m    const url = `mailto:${mailTo}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;[m
[32m+[m[32m    window.location.href = url;[m
[32m+[m[32m  });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction initFloatingContact(){[m
[32m+[m[32m  const btn = document.getElementById('floating-contact');[m
[32m+[m[32m  if(!btn) return;[m
[32m+[m[32m  btn.addEventListener('click', () => {[m
[32m+[m[32m    const contact = document.getElementById('contact');[m
[32m+[m[32m    if(contact) contact.scrollIntoView({behavior:'smooth', block:'start'});[m
[32m+[m[32m  });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction initParallax(){[m
[32m+[m[32m  window.addEventListener('scroll', () => {[m
[32m+[m[32m    const sections = $$('section');[m
[32m+[m[32m    sections.forEach(section => {[m
[32m+[m[32m      const rect = section.getBoundingClientRect();[m
[32m+[m[32m      const scrollPercent = (window.innerHeight - rect.top) / window.innerHeight;[m
[32m+[m[32m      if(scrollPercent > 0 && scrollPercent < 1.5){[m
[32m+[m[32m        const offset = (1 - scrollPercent) * 20;[m
[32m+[m[32m        section.style.transform = `translateY(${offset}px)`;[m
[32m+[m[32m      }[m
[32m+[m[32m    });[m
[32m+[m[32m  });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mdocument.addEventListener('DOMContentLoaded', () => {[m
[32m+[m[32m  setYear();[m
[32m+[m[32m  runTypingEffect('typed-lines', HERO_LINES);[m
[32m+[m[32m  initNav();[m
[32m+[m[32m  initThemeSwitcher();[m
[32m+[m[32m  initRevealAndSkills();[m
[32m+[m[32m  renderCertificates();[m
[32m+[m[32m  wireProjects();[m
[32m+[m[32m  initEnquiryForm();[m
[32m+[m[32m  initFloatingContact();[m
[32m+[m[32m  initParallax();[m
[32m+[m[32m});[m
